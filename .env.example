# ROAD SENSE - variabili di ambiente del FRONTEND
# Copiare in `.env.local` (ignorato da git) e adattare.
#
# ATTENZIONE: tutto cio' che inizia con VITE_ finisce nel bundle pubblico.
# NON inserire qui token, chiavi o credenziali: il frontend di ROAD SENSE
# non ha e non deve avere segreti.

# Base URL delle API del backend collaborativo (Cloudflare Worker).
# Lasciare VUOTO per usare ROAD SENSE in modalita' solo-locale (default v0.1.0):
# gli eventi restano sul dispositivo e non viene effettuata alcuna chiamata di rete.
# Esempi validi:
#   VITE_API_BASE=/api                       (Worker servito sullo stesso dominio)
#   VITE_API_BASE=https://roadsense-api.example.workers.dev
VITE_API_BASE=

# Sorgente cartografica. Lasciare VUOTO per usare quella predefinita
# (OpenFreeMap Dark). Valori riconosciuti: vedere MAP_PROVIDERS in
# src/config/mapProviders.ts. Un valore sconosciuto ricade sul predefinito.
#   VITE_MAP_PROVIDER=openfreemap-dark
#   VITE_MAP_PROVIDER=openfreemap-positron
VITE_MAP_PROVIDER=
